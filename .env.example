# Copy to .env.local for local development. On Vercel, add these under
# Project → Settings → Environment Variables. Never commit real values.

# Neon: Connection string from the Neon console ("Connect" button, pooled connection).
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Password for the /admin page (username can be anything, e.g. "vtl").
ADMIN_PASSWORD=choose-a-long-password

# Public address of the app, no trailing slash. Used for links inside emails.
SITE_URL=https://freshdrip-masters.vercel.app

# --- Email (optional but recommended) -------------------------------------
# Resend API key from resend.com. Leave empty to switch emails off.
RESEND_API_KEY=
# Sender. Until you verify your own domain in Resend, use onboarding@resend.dev,
# which can only deliver to the Resend account owner's address.
EMAIL_FROM=freshDRIP <onboarding@resend.dev>
# Who gets the instant lead alert. Comma-separate several addresses.
LEAD_ALERT_EMAIL=ezulu@vilag.io

# --- Contact shown on the "Save VTL to contacts" card ----------------------
CONTACT_NAME=Emmanuel Zulu
CONTACT_PHONE=+260970850065
CONTACT_EMAIL=ezulu@vilag.io
